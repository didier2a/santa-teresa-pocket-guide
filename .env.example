# Secrets must be configured in Vercel. Never commit real values.
OPENAI_API_KEY=
LIVEAVATAR_API_KEY=
# Backward-compatible alias used by the first V2.4 lab deployment.
HEYGEN_API_KEY=

# LiveAvatar identity created for PocketGuide (not a secret, kept server-side).
HEYGEN_AVATAR_ID=664ff8bb-4932-4644-91f8-b90975d6f549
HEYGEN_LIVEAVATAR_SANDBOX=false
# Optional overrides. When absent, the server creates/reuses encrypted LiveAvatar records.
LIVEAVATAR_OPENAI_SECRET_ID=
LIVEAVATAR_CONTEXT_ID=
LIVEAVATAR_OPENAI_MODEL=gpt-realtime
