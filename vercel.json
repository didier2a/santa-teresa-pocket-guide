{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/pocketguide-3-preview", "destination": "/pocketguide-v23.html?v3=1&v233=1&liveavatar=1" },
    { "source": "/pocketguide-3-preview/", "destination": "/pocketguide-v23.html?v3=1&v233=1&liveavatar=1" },
    { "source": "/pocketguide-2.3.3", "destination": "/pocketguide-v23.html?v233=1&liveavatar=1" },
    { "source": "/pocketguide-2.3.3/", "destination": "/pocketguide-v23.html?v233=1&liveavatar=1" }
  ],
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "functions": {
    "api/plan.js": { "maxDuration": 20 },
    "api/plan-status.js": { "maxDuration": 20 },
    "api/transcribe.js": { "maxDuration": 30 },
    "api/tts.js": { "maxDuration": 30 },
    "api/liveavatar-session.js": { "maxDuration": 20 },
    "api/liveavatar-status.js": { "maxDuration": 20 },
    "api/client-diagnostic.js": { "maxDuration": 10 },
    "api/validate-routepack.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
