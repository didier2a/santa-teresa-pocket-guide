{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {"source":"/pocketguide-4-preview","destination":"/pocketguide-v4.html?liveavatar=1"},
    {"source":"/pocketguide-4-preview/","destination":"/pocketguide-v4.html?liveavatar=1"}
  ],
  "ignoreCommand": "test -n \"$VERCEL_GIT_PREVIOUS_SHA\"&&git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- api/ engine/ js/ vendor/liveavatar/ assets/companion/ data/routepacks/ pocketguide-v4.html pocketguide-v4.css manifest-v4.webmanifest vercel.json",
  "functions": {
    "api/plan.js": { "maxDuration": 20 },
    "api/plan-status.js": { "maxDuration": 20 },
    "api/transcribe.js": { "maxDuration": 30 },
    "api/tts.js": { "maxDuration": 30 },
    "api/liveavatar-session.js": { "maxDuration": 20 },
    "api/companion-session.js": { "maxDuration": 20 },
    "api/liveavatar-session-v4.js": { "maxDuration": 20 },
    "api/liveavatar-status.js": { "maxDuration": 20 },
    "api/validate-routepack.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
