{
  "functions": {
    "api/plan.js": { "maxDuration": 20 },
    "api/plan-status.js": { "maxDuration": 20 },
    "api/transcribe.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
