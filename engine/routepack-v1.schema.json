{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketguide.local/schema/routepack-v1.schema.json",
  "title": "PocketGuide RoutePack V1",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "timezone", "days", "places"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "timezone": {"type": "string", "minLength": 1},
    "travelers": {"type": "integer", "minimum": 1},
    "start": {"type": "string", "format": "date"},
    "end": {"type": "string", "format": "date"},
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "events"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "label": {"type": "string"},
          "subtitle": {"type": "string"},
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "time", "end", "title", "type"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "time": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
                "end": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
                "title": {"type": "string", "minLength": 1},
                "type": {"type": "string", "minLength": 1},
                "place": {"type": "string"},
                "placeId": {"type": "string"},
                "fixed": {"type": "boolean"},
                "locked": {"type": "boolean"},
                "calendarUrl": {"type": "string"},
                "notes": {"type": "string"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "lat", "lng"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lng": {"type": "number", "minimum": -180, "maximum": 180},
          "icon": {"type": "string"},
          "description": {"type": "string"},
          "historyShort": {"type": "string"},
          "historyLong": {"type": "string"},
          "arCue": {"type": "string"},
          "repere": {"type": "string"},
          "heroImage": {"type": "string"},
          "waze": {"type": "string"},
          "sourceLabel": {"type": "string"},
          "sourceUrl": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "offline": {"type": "object", "additionalProperties": true},
    "meta": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
